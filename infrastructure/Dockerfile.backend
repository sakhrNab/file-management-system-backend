FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    curl \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY main.py .

# Create logs directory
RUN mkdir -p logs

# Expose port (backend uses 8003 by default)
EXPOSE 8003

# Copy enhanced health check script
COPY health_check.sh /usr/local/bin/health_check.sh
RUN chmod +x /usr/local/bin/health_check.sh

# Enhanced health check that detects 503 errors and unreachable states
HEALTHCHECK --interval=10s --timeout=8s --start-period=30s --retries=3 \
    CMD /usr/local/bin/health_check.sh || exit 1

# Run the application with optimized settings
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8003", "--workers", "1", "--loop", "uvloop", "--http", "httptools", "--access-log", "--log-level", "info"]
